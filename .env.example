# HTTP port for the Axum server. The default avoids the neighboring web-server
# application's usual port 3000.
JOB_WATCHER_PORT=3004

# LINE Messaging API credentials.
# Create a LINE Official Account and issue a channel access token.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-channel-access-token
LINE_USER_ID=replace-with-recipient-user-id

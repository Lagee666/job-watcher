# Copy this file to /etc/job-watcher/job-watcher.env on the Raspberry Pi.

# Axum HTTP and LINE webhook listener.
JOB_WATCHER_PORT=3004

# LINE Messaging API credentials.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-channel-access-token
LINE_USER_ID=replace-with-recipient-user-id

# Local change history and full-JD exports.
JOB_WATCHER_CHANGE_DIR=/var/lib/job-watcher/changes
# Local MM-DD full-JD batch folders used by all synchronization modes (10 JDs per file).
JOB_WATCHER_JD_DIR=/var/lib/job-watcher/changes
# One-shot binaries: true sends the completion digest to LINE.
JOB_WATCHER_LINE_BOT=false

# Optional LinkedIn Job Alert source through the Gmail API.
LINKEDIN_ENABLED=false
GMAIL_OAUTH_CLIENT_FILE=/etc/job-watcher/google-oauth-client.json
GMAIL_OAUTH_TOKEN_FILE=/var/lib/job-watcher/gmail-oauth-token.json
LINKEDIN_PROCESSED_MESSAGES_FILE=/var/lib/job-watcher/linkedin-processed-gmail-messages.json
LINKEDIN_GMAIL_QUERY=from:(linkedin.com) newer_than:30d

# Optional Gmail SMTP notification.
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
JOB_WATCHER_EMAIL_TO=
